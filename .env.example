# Copy to .env (git-ignored) for local development. Real environment variables take precedence.

DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1
# Production example: ALLOWED_HOSTS=your-domain.com   CSRF_TRUSTED_ORIGINS=https://your-domain.com
CSRF_TRUSTED_ORIGINS=

DATABASE_URL=postgres://user:password@localhost:5432/fuel_station
# Optional; when set the Django Redis cache is used, otherwise in-process LocMem
REDIS_URL=

# Free key from https://openrouteservice.org/
ORS_API_KEY=

# Optional tuning (invalid values stop the app at startup with a clear message)
VEHICLE_RANGE_MILES=500
VEHICLE_MPG=10
STATION_CORRIDOR_MILES=10
ROUTE_CACHE_TTL=86400
ORS_CONNECT_TIMEOUT=3
ORS_READ_TIMEOUT=15
ORS_MAX_RETRIES=1
PLAN_THROTTLE_RATE=30/min
